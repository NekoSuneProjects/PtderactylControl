# Your Pterodactyl panel URL, without a trailing slash.
PTERODACTYL_URL=https://panel.example.com

# A Client API key controls servers, reads live resources and issues console tickets.
PTERODACTYL_CLIENT_API_KEY=ptlc_replace_me

# Optional on Pterodactyl 1.8+: an admin Client key can call Application endpoints.
# Older installations should use an Application API key here.
PTERODACTYL_APPLICATION_API_KEY=ptla_replace_me

# Protects this remote dashboard. Required in production.
CONTROL_PANEL_PASSWORD=change-this-password
SESSION_SECRET=replace-with-at-least-32-random-characters

PORT=8787
DEMO_MODE=false
NODE_ENV=development
