{
  "name": "Example Paper Server",
  "description": "Created with pteroctl",
  "user": 1,
  "egg": 1,
  "docker_image": "ghcr.io/pterodactyl/yolks:java_21",
  "startup": "java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}",
  "environment": {
    "SERVER_JARFILE": "server.jar",
    "BUILD_NUMBER": "latest"
  },
  "limits": {
    "memory": 4096,
    "swap": 0,
    "disk": 20480,
    "io": 500,
    "cpu": 200
  },
  "feature_limits": {
    "databases": 2,
    "allocations": 1,
    "backups": 3
  },
  "allocation": {
    "default": 1
  },
  "start_on_completion": true
}
